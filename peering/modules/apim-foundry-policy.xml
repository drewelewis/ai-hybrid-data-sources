                          <metadata name="productId" value="@(context.Product?.Id ?? string.Empty)" />
                          <metadata name="subscriptionId" value="@(context.Subscription?.Id ?? string.Empty)" />
                          <metadata name="model" value="@(context.Variables.GetValueOrDefault&lt;string&gt;(&quot;llmmgmt-model&quot;, string.Empty))" />
