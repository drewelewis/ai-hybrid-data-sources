          <dimension name="Subscription ID" />
          <dimension name="Backend ID" />
          <dimension name="Deployment" value="@(context.Variables.GetValueOrDefault&lt;string&gt;(&quot;llmmgmt-model&quot;))" />
        </llm-emit-token-metric>
        <choose>
          <when condition="@(((JObject)context.Variables[&quot;llmmgmt-config&quot;]).TryGetValue(&quot;skuGlobalMaxCallsPerMinute&quot;, StringComparison.OrdinalIgnoreCase, out var skuMaxCalls) &amp;&amp; skuMaxCalls.Value&lt;int&gt;() &gt; 0)">
