GITHUB_PAT=github_pat_your_token_here

AZURE_SUBSCRIPTION_ID=your-subscription-id

# Model route: "apim" for the governed gateway or "direct" for Foundry.
MODEL_ENDPOINT_MODE=apim
MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2024-02-01

# Governed APIM model API. Keep the endpoint at the gateway origin; the Azure
# OpenAI SDK appends /openai/deployments/{deployment}/chat/completions.
APIM_OPENAI_ENDPOINT=https://your-apim-instance.azure-api.net
APIM_TOKEN_SCOPE=api://your-apim-api-app-client-id/.default
APIM_SUBSCRIPTION_KEY=your-server-side-apim-subscription-key

# Direct Azure AI Foundry route (used only when MODEL_ENDPOINT_MODE=direct).
AZURE_OPENAI_API_ENDPOINT=https://your-foundry-instance.cognitiveservices.azure.com/
AZURE_OPENAI_TOKEN_SCOPE=https://cognitiveservices.azure.com/.default
AZURE_OPENAI_API_RESOURCE_ID=/subscriptions/your-subscription-id/resourceGroups/your-rg/providers/Microsoft.CognitiveServices/accounts/your-foundry-instance

# Azure AI Foundry Project Configuration
AZURE_PROJECT_ENDPOINT=https://your-foundry-instance.services.ai.azure.com/api/projects/your-project
AZURE_PROJECT_RESOURCE_ID=/subscriptions/your-subscription-id/resourceGroups/your-rg/providers/Microsoft.CognitiveServices/accounts/your-foundry-instance/projects/your-project

# Agent Server Configuration (required by azure.ai.agentserver)
AGENT_PROJECT_RESOURCE_ID=/subscriptions/your-subscription-id/resourceGroups/your-rg/providers/Microsoft.CognitiveServices/accounts/your-foundry-instance/projects/your-project

# Azure PostgreSQL Flexible Server
POSTGRES_HOST=your-server.postgres.database.azure.com
POSTGRES_USER=your-admin-user
POSTGRES_PASSWORD=your-password
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_SSL_MODE=require

# Docker
DOCKER_REPO_NAME=your-dockerhub-user/ai-agent-starter-portfolio-manager

# Azure API Management MCP Server
APIM_MCP_SERVER_URL=https://your-apim-instance.azure-api.net/trading-platform-mcp-server/mcp

# tag:A365 config - Opt-in telemetry and blueprint/child-agent identity; keep secret values out of this file.
# Microsoft Agent 365 metadata-only observability. Keep disabled until the
# blueprint and agent identity are registered. Set A365_RECORD_CONTENT=true
# only for an approved nonproduction policy test because it can transmit
# prompts, responses, and portfolio data. Supply the blueprint client secret
# only through the git-ignored .env; never add it to this sample.
ENABLE_A365_OBSERVABILITY=false
A365_TENANT_ID=00000000-0000-0000-0000-000000000000
A365_BLUEPRINT_CLIENT_ID=00000000-0000-0000-0000-000000000000
A365_AGENT_ID=00000000-0000-0000-0000-000000000000
A365_RECORD_CONTENT=false
A365_CHANNEL_NAME=local-cli
A365_SERVER_ADDRESS=localhost
A365_SERVER_PORT=8989

# tag:A365 config - Independent Graph read/write flags; enabling them never provisions or consents access.
# Optional read-only Graph calendar pilot. Requires separately approved Entra
# OBO setup and delegated Calendars.ReadBasic on the agent identity. chat.py
# obtains a separate blueprint-audience user token; never reuse the APIM token.
# The existing A365_BLUEPRINT_CLIENT_SECRET stays server-side in ignored .env.
ENABLE_GRAPH_CALENDAR=false
# Optional briefing-save and customer-invitation proposal/confirm workflows.
# Requires separately approved delegated
# Calendars.ReadWrite for the pilot user; never grants itself permissions.
ENABLE_GRAPH_CALENDAR_WRITE=false
# Fixed offset defining "today"; update for daylight saving or use +00:00.
GRAPH_CALENDAR_UTC_OFFSET=+00:00