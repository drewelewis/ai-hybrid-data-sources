# On-premises runtime lifecycle stage: local, dev, tst, or prd.
ENVIRONMENT_NAME=local

# Azure OpenAI-compatible model route exposed by API Management.
# Keep the endpoint at the APIM gateway origin; do not append /openai.
APIM_OPENAI_ENDPOINT=https://your-apim-instance.azure-api.net
APIM_TOKEN_SCOPE=api://your-apim-api-app-client-id/.default
APIM_SUBSCRIPTION_KEY=your-server-side-apim-subscription-key
MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2024-02-01

# "default" uses DefaultAzureCredential. For an explicit local device-code
# sign-in, use "device-code" and provide the tenant and public client IDs.
AZURE_AUTH_MODE=default
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
