        <mxCell id="m6" value="6  Request Cognitive Services token using APIM managed identity" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8A8886;strokeWidth=2;fontFamily=Segoe UI;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="745" as="sourcePoint"/><mxPoint x="1485" y="745" as="targetPoint"/></mxGeometry></mxCell>
