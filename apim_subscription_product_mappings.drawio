        <mxCell id="retry-note" value="On 408, 429, 500, 502, or 503:&lt;br&gt;retry up to 3 times at 3-second intervals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#D83B01;fontFamily=Segoe UI;fontColor=#323130;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1360" y="820" width="250" height="58" as="geometry"/></mxCell>
