        <mxCell id="m1" value="1  Enter prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5C2D91;strokeWidth=2;fontFamily=Segoe UI;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="275" as="sourcePoint"/><mxPoint x="375" y="275" as="targetPoint"/></mxGeometry></mxCell>
