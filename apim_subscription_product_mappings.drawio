        <mxCell id="m3" value="3  HTTPS request with subscription key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#107C10;strokeWidth=2;fontFamily=Segoe UI;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="645" y="445" as="sourcePoint"/><mxPoint x="925" y="445" as="targetPoint"/></mxGeometry></mxCell>
